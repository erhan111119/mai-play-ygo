+                    main.ActivableDescs[i], "发动 " + DescribeCard(main.ActivableCards[i])));
+            foreach (ClientCard card in main.SpellSetableCards)
+                options.Add(new IdleOption(MainPhaseAction.MainAction.SetSpell, card, 0, "盖放 " + DescribeCard(card)));
+            foreach (ClientCard card in main.MonsterSetableCards)
+                options.Add(new IdleOption(MainPhaseAction.MainAction.SetMonster, card, 0, "里侧盖放 " + DescribeCard(card)));
