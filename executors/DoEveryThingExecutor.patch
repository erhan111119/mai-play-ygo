+        /// <summary>
+        /// 对面**空场**时"能打出伤害就进战斗阶段"（＝压血）。
+        ///
+        /// 为什么要有它（2026-10-08）：各卡组执行器的 `LethalAvailable()` 在对面空场时要求**一击斩杀**
+        /// （`damage >= Enemy.LifePoints`）才进战阶，于是"打不到斩杀就整局不进攻"——本机日志里
+        /// 「杀调 / 虫惑魔蕾祸 / 魔女术 / 耀圣」都出现过**整局 0 次攻击宣言**、一滴伤害没打出去。
+        /// 对面空场时攻击只会白赚伤害，而"打不打某一只"仍由 `OnSelectAttackTarget` 那一步判
+        /// （它会拒绝打不过的），所以这里只负责"进战阶"这一步。
+        ///
+        /// 只在自己回合、内核说这一步能进战阶、且**对面怪兽区为空**时成立；对面有怪时不在这条
+        /// 通用规则里抢（各执行器有自己的"能不能拆掉一只已知怪"判据，那条比通用规则懂得多）。
+        /// 开关：`EnemyTargeting.BattlePressure`（环境变量 `AI_BATTLE_PRESSURE=0` 回到旧口径，A/B 用）。
+        /// </summary>
+        protected bool BattlePressureWorthIt()
+        {
+            if (!EnemyTargeting.BattlePressure)
+                return false;
+            if (Duel.Player != 0 || Duel.MainPhase == null || !Duel.MainPhase.CanBattlePhase)
+                return false;
+            if (Enemy.GetMonsterCount() > 0)
+                return false;
+            int damage = 0;
+            foreach (ClientCard card in Bot.GetMonsters())
+            {
+                if (card == null || !card.IsFaceup() || !card.IsAttack())
+                    continue;
+                damage += card.GetAttackPower();
+            }
+            if (damage <= 0)
+                return false;
+            if (Config.GetBool("Debug", false))
+                Logger.WriteLine("[战斗] 对面空场，能打 " + damage + " → 进战斗阶段（压血）");
+            return true;
+        }
