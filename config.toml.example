# 麦麦玩游戏王（Mai Play YGO）· 配置模板
#
# 用法：复制成 config.toml 再改（`cp config.toml.example config.toml`）。
# 仓库里**只放这份模板**：真正在跑的 config.toml 是本地文件（已加进 .gitignore），
# 这样升级/拉取代码时不会和你的本地配置打架，也不会有谁的隧道地址被提交上去。
#
# 每一项都写着默认值与作用；不想改的项整行删掉即可（会回落默认值）。
# 路径支持「相对于插件目录」的写法（推荐）：默认值就指向插件自带的 clients/，
# 把插件目录整个拷到别的机器上也能直接跑，不用改绝对路径。

[plugin]
# 插件：插件基础配置。
enabled = false  # 是否启用插件（复制成 config.toml 后改成 true）
config_version = "1.2.0"  # 配置版本

[paths]
# 运行环境：两个虚拟客户端与数据文件的位置（默认都在插件自带的 clients/ 里）
ygopro_executable = "clients/ygopro/ygopro.exe"  # ygopro.exe 路径（必须是用服务端模式构建的版本）
ygopro_dir = "clients/ygopro"  # ygopro 工作目录，需要包含 cards.cdb、lflist.conf、script/ 与 expansions/
windbot_executable = "clients/windbot/WindBot.exe"  # WindBot.exe 路径（bot 的出牌大脑）
windbot_dir = "clients/windbot"  # WindBot 工作目录，需要包含 Decks/ 与 x64/sqlite3.dll（运行时会往里写卡表与计划文件）
cards_cdb = "clients/ygopro/cards.cdb"  # cards.cdb 路径；留空则用 ygopro 工作目录下的同名文件
card_art_dir = "clients/art/Art"  # 卡图目录（查房出图与发卡图用；缺图会退到 card_art_fallback_dir，再缺就画卡名框）
card_art_fallback_dir = "clients/art/Closeup"  # 备用卡图目录（大图；Art 里没有的卡常在这里能找到）
windbot_src_dir = ""  # 【可选】WindBot 源码树（含 WindBot.csproj）：自己或 agent 写的执行器要在这里编译，玩法见 executors/README.md

[duel]
# 对局：开房、播报与局内说话。
# **这里只有群主要用的十项**；AI 教练、房间规则这些内部参数仍在代码里
# （老配置里写过的键照旧能读），只是不再出现在配置页与这份模板上。
bot_name = "麦麦"  # bot 在对局中显示的名字
public_host = ""  # 发给群友的服务器地址；留空自动探测局域网地址（做内网穿透时填隧道域名/公网地址）
public_port = 0  # 发给群友的端口；0 表示用闸门监听端口（隧道公网端口与本地不同时填这里）
listen_port = 0  # 闸门监听端口；0 表示随机分配空闲端口
join_timeout_seconds = 300  # 开完房等群友进来的秒数，超时自动收摊（人一直没来就别占着端口）
announce_result = true  # 打完之后是否把对局总结发到群里
summarize_with_ai = true  # 总结是否先交给模型写成一段人话再发（关掉或模型不可用时发原始复述）
summary_prompt = ""  # 【总结的提示词】留空用内置那份；可用占位符 self_name/report/verdict/winner/turns（见 README）
taunt_enabled = false  # 局内是否按概率说挑衅台词（默认关：开房把地址与口令发出去之后就不再讲话）
taunt_lines = []  # 挑衅台词池（集合，一条一句）；留空用内置的 20 句（duel/taunts.py）

# 阻抗决策层（2026-10-08）：**只在阻抗时点**让模型参与决策，展开期一步都不问。
# 三个都是内部参数（配置页不显示）；不写＝按下面注释里的默认值。
# **用哪只模型见下面的 [llm] 节**（`decision_model` / `decision_timeout_ms`）：
# 2026-10-08 起模型与超时统一收进 [llm]，这里只剩"开哪半"与答复额度。
# brain_enabled = true       # 让模型决定「这张无效卡该去针对对面哪只怪」（默认开）
# brain_negate_gate = true   # 让模型决定「对面发动效果时，我方能发的这几张里发哪张 / 都不发」
#                            # 默认开（用户口径：靠真人对战体感定；镜像自测分不出高下，见 executors/README §3.5）
# brain_max_tokens = 256     # 答复额度上限；答复只有一个序号或 no;理由，给小一点更稳

[llm]
# 模型：这一节**只写模型名**——填宿主 `model_config.toml` 里那只模型的名字。
# 留空表示用宿主给插件配的那只（`model_config.toml` 的 plugin 任务）。
# 三个用途各管一件事，谁都不用别人的模型。
summary_model = ""  # 【对局总结】把机读复述写成一段人话；这活儿对智力要求低，哪只都行
summary_timeout_ms = 60000  # 【对局总结】等模型的上限（毫秒）。总结额度是 16384 token，思考型模型会先想一大段，给短了会稳定超时（群里看起来就是"没有 AI 总结"）
decision_model = "deepseek-chat"  # 【AI 决策】阻抗决策层用哪只。**推荐小体量、不思考的那种**：对手回合的等待预算只有 15 秒，会思考的答复要 13 秒
decision_timeout_ms = 2500  # 【AI 决策】WindBot 等答复的上限（毫秒）；Python 侧自动取这个值再减 400，好让超时由插件先发现并记账
decision_style = "aggressive"  # 决策档位：conservative / normal / aggressive（也认 保守/平常/激进）；只改提示词，不用重编译 exe
training_model = ""  # 【训练功能】读卡文推 combo、复盘、写结论用哪只。⚠ 要填**不思考**的（如 deepseek-chat）：宿主对插件的单次模型调用有 30 秒硬超时（cap.call），会思考的模型（本机的 `ds`/`deepseekV4.1flash`）光"想"就超时；留空＝宿主给插件配的那只
training_timeout_ms = 25000  # 【训练功能】单次等模型的上限（毫秒）。**给不大**：宿主那侧 30 秒就断（cap.call），给 120000 也无效；给 25 秒是为了让失败由插件先发现，并在记录里说清"是模型太慢、该换哪只"

[wiki]
# 百科检索：查卡 / 发卡图
endpoint = "https://ygocdb.com/api/v0/"  # 查卡接口地址（ygocdb 兼容；换自建/镜像时改这里，末尾带斜杠）
timeout = 15  # 在线接口超时时间（秒）：查卡与取卡图都用它

[training]
# 训练功能（插件里的「研究台」）：推演 combo / 复盘录像 / 预校验脚本 / 跑擂台 A/B。
# **用哪只模型在 [llm] 里**（`training_model`），这一节只放开关与放东西的地方。
# 训练任务都在插件自带的面板里发起与查看（不在群里用命令）——面板配置见下面的 [webui]。
enabled = true  # 是否启用训练功能（关掉后面板只展示历史记录，不受理新任务；对局侧不受影响）
workspace = ""  # 训练工作目录：擂台数据库、训练日志、推演结果都放这儿；留空＝插件数据目录下的 train/
max_duels_per_run = 60  # 一次擂台最多打多少局（逐局交替座位，最多 200）。⚠ 这是"一次任务的上限"，不是"判强弱要多少局"——实测同一套构筑重测会出现 0/60 与 8/20 并存的噪声，判强弱要 ≥80 局/腿

[webui]
# 面板：插件自带的小 HTTP 服务（`webui.py`），只为了把"群里说不清的东西"摊开看：
# 卡组池、日志、训练任务与结果。**新功能不往群里加命令，都在这儿。**
enabled = true  # 是否随插件一起启动面板
host = "127.0.0.1"  # 监听地址。默认只监听本机（面板能看到卡组池与日志，不该默认对外）；想让手机/别的机器访问再改 0.0.0.0，改之前先确认密钥足够长且端口不暴露在公网
port = 17911  # 监听端口；被别的程序占用时面板启动失败并记一条 warning（对局不受影响），换一个空闲端口即可
api_key = ""  # 面板密钥。留空＝按「环境变量 YGO_WEBUI_KEY → 自动生成」取；自动生成的密钥写在插件数据目录的 webui_key.txt，登录页会告诉你去看那个文件。**别把密钥提交进版本库**
