{
  "manifest_version": 2,
  "version": "1.0.0",
  "id": "mai-play-ygo",
  "name": "麦麦玩游戏王",
  "description": "让麦麦陪你打牌、也帮你查牌：一条指令开一局游戏王（自动建房并把地址与房间口令发到群里，群友用 MDPro3 / YGOMobile 连进来对战，打完结账播报并写进聊天记忆）；同时提供游戏王百科检索——查卡（中文/日文/英文名、效果、攻守、FAQ）、解析卡组码（YDK / YDKE / 萌卡分享链接）、发卡图。对局内核 ygopro 与出牌大脑 WindBot 两个虚拟客户端随插件自带（clients/），开箱即用；也支持 /查房 看棋盘图、AI 教练、卡组投稿与卡组池随机。",
  "author": {
    "name": "erhan111119",
    "url": "https://github.com/erhan111119"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/erhan111119/mai-play-ygo",
    "homepage": "https://github.com/erhan111119/mai-play-ygo",
    "documentation": "https://github.com/erhan111119/mai-play-ygo/blob/main/README.md",
    "issues": "https://github.com/erhan111119/mai-play-ygo/issues"
  },
  "changelog": "CHANGELOG.md",
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.0"
  },
  "sdk": {
    "min_version": "2.5.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "send.image",
    "llm.generate",
    "maisaka.context.append",
    "chat.get_all_streams",
    "render.html2png"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "plugin_type": "extension"
}
